# OGS local development infrastructure (copy to .env — never commit .env files)
# Used by: infrastructure/docker/compose.yaml (via `pnpm infra:up`).
#
# These are placeholders for a LOCAL machine only. Choose your own values.
# Keep DATABASE_URL / REDIS_URL in apps/api/.env consistent with them.

COMPOSE_PROJECT_NAME=ogs

# PostgreSQL
POSTGRES_USER=ogs
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ogs_dev
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

# OGS database roles (created by infrastructure/docker/postgres/init/00-ogs-roles.sh).
# Keep the matching URLs in apps/api/.env consistent with these.
OGS_OWNER_PASSWORD=change-me-local-only
OGS_APP_PASSWORD=change-me-local-only
OGS_READONLY_PASSWORD=change-me-local-only
OGS_MAINT_PASSWORD=change-me-local-only

# Mailpit (development email inbox): http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Object storage for files (SeaweedFS S3 gateway, development only).
# Keep OBJECTSTORE_ACCESS_KEY / OBJECTSTORE_SECRET_KEY equal to S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY in apps/api/.env.
OBJECTSTORE_ACCESS_KEY=ogs-files
OBJECTSTORE_SECRET_KEY=change-me-local-only
OBJECTSTORE_PORT=8333
