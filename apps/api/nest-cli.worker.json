{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "worker",
  "compilerOptions": {
    "builder": "tsc",
    "tsConfigPath": "tsconfig.worker-dev.json",
    "deleteOutDir": true,
    "assets": [
      {
        "include": "identity/data/*.txt",
        "watchAssets": true
      }
    ]
  }
}
