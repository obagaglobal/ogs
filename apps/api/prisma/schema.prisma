// OGS Prisma schema.
//
// Prisma does not model row-level security, policies, triggers, grants, CHECK
// constraints or partial indexes. Those live as hand-written SQL in the migration
// files (create migrations with `pnpm db:migrate:dev --create-only`, then edit).
// The RLS catalogue test (test/integration/rls-catalogue.int.test.ts) fails CI if a
// table is added without RLS + FORCE + a policy.
//
// Connection settings live in ../prisma.config.ts (DATABASE_MIGRATION_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy (Phase 2). Review §5, ADR-009.
// ---------------------------------------------------------------------------

enum TenantKind {
  ORGANISATION
  PROVIDER_COMPANY
  PLATFORM
}

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

/// An organisation, a provider company, or the single PLATFORM tenant (OGS staff).
model Tenant {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind                    TenantKind
  status                  TenantStatus             @default(PENDING_APPROVAL)
  name                    String                   @db.VarChar(200)
  /// Lower-case, URL-safe, globally unique (CHECK in SQL).
  slug                    String                   @unique @db.VarChar(100)
  version                 Int                      @default(0)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(6)
  memberships             Membership[]
  roles                   Role[]
  memberRoles             MembershipRole[]
  organisationProfile     OrganisationProfile?
  organisationApplication OrganisationApplication?
  invitations             Invitation[]
  departments             Department[]
  billing                 OrganisationBilling?

  @@map("tenant")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// One row per human (review §7). Phase 2 is deliberately minimal: credentials,
/// profile and MFA are added in Phase 3.
model AppUser {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String         @unique @db.Citext
  status        UserStatus     @default(PENDING_VERIFICATION)
  /// True once a TOTP factor is confirmed (kept in step by identity jobs; read by the access guard).
  mfaEnabled    Boolean        @default(false) @map("mfa_enabled")
  version       Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  memberships   Membership[]
  credential    Credential?
  tokens        UserToken[]
  mfaFactor     MfaFactor?
  recoveryCodes RecoveryCode[]

  @@map("app_user")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

/// A user's capacity inside a tenant. Roles and departments arrive in Phases 3–4.
model Membership {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  status       MembershipStatus @default(INVITED)
  joinedAt     DateTime?        @map("joined_at") @db.Timestamptz(6)
  endedAt      DateTime?        @map("ended_at") @db.Timestamptz(6)
  version      Int              @default(0)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]
  /// Optional department (organisations only, Phase 4).
  departmentId String?          @map("department_id") @db.Uuid
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Cross-cutting foundations moved into Phase 2 (ADR-015).
// ---------------------------------------------------------------------------

enum ActorKind {
  USER
  SYSTEM
}

/// Append-only. UPDATE/DELETE/TRUNCATE are rejected by trigger for every role.
/// No foreign keys on purpose: the log must outlive and never block the rows it describes.
/// actor_user_id and actor_kind are filled from the transaction's context and an
/// RLS check rejects any other value, so callers cannot spoof the actor.
model AuditLog {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorKind   ActorKind @default(dbgenerated("app.current_actor_kind()")) @map("actor_kind")
  actorUserId String?   @default(dbgenerated("app.current_user_id()")) @map("actor_user_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  action      String    @db.VarChar(100)
  entityType  String?   @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.VarChar(100)
  reason      String?   @db.VarChar(500)
  requestId   String?   @map("request_id") @db.VarChar(100)
  ip          String?   @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  metadata    Json      @default("{}")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

/// Transactional outbox (review §3). Written in the same transaction as the
/// business change; read and marked dispatched only under the `system` context.
model OutboxEvent {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         String    @db.VarChar(150)
  tenantId     String?   @map("tenant_id") @db.Uuid
  payload      Json
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") @db.VarChar(2000)

  @@index([dispatchedAt, availableAt])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------
// Identity (Phase 3A). Review §7, ADR-011, Phase 3 plan §2.
// Reached only under `system` context with an `identity.*` job (see RLS in
// the migration): login and registration happen before any user context exists.
// ---------------------------------------------------------------------------

/// One password credential per user. Argon2id PHC string (parameters inside).
model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credential")
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use emailed tokens. Only the SHA-256 of the token is stored.
model UserToken {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    UserTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user       AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_token")
}

enum AuthEventKind {
  REGISTERED
  REGISTER_EXISTING_EMAIL
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  SESSION_REVOKED
  MFA_ENABLED
  MFA_DISABLED
  MFA_VERIFIED
  MFA_FAILED
  RECOVERY_CODE_USED
  RECOVERY_CODES_REGENERATED
}

/// Append-only security log of authentication activity (trigger-protected).
model AuthenticationEvent {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  kind       AuthEventKind
  userId     String?       @map("user_id") @db.Uuid
  /// SHA-256 of the normalised email, to correlate attacks on unknown accounts without storing them.
  emailHash  String?       @map("email_hash") @db.Char(64)
  reason     String?       @db.VarChar(100)
  ip         String?       @db.Inet
  userAgent  String?       @map("user_agent") @db.VarChar(500)
  requestId  String?       @map("request_id") @db.VarChar(100)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([emailHash, occurredAt(sort: Desc)])
  @@map("authentication_event")
}

enum DeliveryStatus {
  PENDING
  SENT
}

/// Idempotency record for outbound notifications: one row per outbox event.
model NotificationDelivery {
  eventId   String         @id @map("event_id") @db.Uuid
  kind      String         @db.VarChar(100)
  userId    String?        @map("user_id") @db.Uuid
  status    DeliveryStatus @default(PENDING)
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("notification_delivery")
}

// ---------------------------------------------------------------------------
// Authorisation (Phase 3A). Review §8. System roles and permissions are synced
// from src/authz/catalogue.json; organisations may add custom roles.
// ---------------------------------------------------------------------------

/// Platform-defined permission code, usable only in the listed tenant kinds.
model Permission {
  code         String           @id @db.VarChar(100)
  description  String           @db.VarChar(300)
  allowedKinds TenantKind[]     @map("allowed_kinds")
  roles        RolePermission[]

  @@map("permission")
}

model Role {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null for system roles; the owning tenant for custom roles.
  tenantId    String?          @map("tenant_id") @db.Uuid
  /// The tenant kind this role may be granted in.
  scope       TenantKind
  code        String           @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.VarChar(300)
  isSystem    Boolean          @default(false) @map("is_system")
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  memberships MembershipRole[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Custom roles: unique per tenant. System roles (tenant_id NULL): partial unique index in SQL.
  @@unique([tenantId, code])
  @@map("role")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

/// A role granted to a membership. tenant_id is denormalised for RLS and kept
/// consistent with the membership by trigger.
model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("membership_role")
}

// ---------------------------------------------------------------------------
// MFA (Phase 3B). Phase 3 plan §3.1. Identity jobs only, like credentials.
// ---------------------------------------------------------------------------

/// One TOTP factor per user (WebAuthn later). The secret is AES-256-GCM encrypted.
model MfaFactor {
  userId       String    @id @map("user_id") @db.Uuid
  /// base64(iv | tag | ciphertext) of the 20-byte TOTP secret.
  secretSealed String    @map("secret_sealed") @db.VarChar(200)
  /// Which MFA_ENCRYPTION_KEY sealed it (key rotation).
  keyId        String    @map("key_id") @db.VarChar(32)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Highest 30-second step accepted so far: a code can never be used twice.
  lastUsedStep BigInt    @default(0) @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("mfa_factor")
}

/// Single-use recovery codes, stored as SHA-256 only.
model RecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("recovery_code")
}

// ---------------------------------------------------------------------------
// Files (Phase 3B). ADR-019, Phase 3 plan §3.3.
// ---------------------------------------------------------------------------

enum FileStatus {
  QUARANTINED
  CLEAN
  REJECTED
}

/// Metadata of an object in the private bucket. Owned by a tenant OR a user.
model FileMetadata {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId         String?           @map("tenant_id") @db.Uuid
  ownerUserId      String?           @map("owner_user_id") @db.Uuid
  purpose          String            @db.VarChar(50)
  originalName     String            @map("original_name") @db.VarChar(255)
  mimeType         String            @map("mime_type") @db.VarChar(100)
  sizeBytes        Int               @map("size_bytes")
  sha256           String            @db.Char(64)
  storageKey       String            @unique @map("storage_key") @db.VarChar(200)
  status           FileStatus        @default(QUARANTINED)
  /// Why a file was rejected (scanner verdict code, never file content).
  statusReason     String?           @map("status_reason") @db.VarChar(100)
  uploadedBy       String            @map("uploaded_by") @db.Uuid
  scannedAt        DateTime?         @map("scanned_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  ticketAttachment TicketAttachment?
  jobEvidence      JobEvidence?

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("file_metadata")
}

// ---------------------------------------------------------------------------
// Organisations (Phase 4). Phase 4 plan §2.
// ---------------------------------------------------------------------------

/// Business details of an organisation tenant (Kenya first, international-ready).
model OrganisationProfile {
  tenantId                    String   @id @map("tenant_id") @db.Uuid
  legalName                   String   @map("legal_name") @db.VarChar(200)
  tradingName                 String?  @map("trading_name") @db.VarChar(200)
  /// Business Registration Service number (Kenya) or the local equivalent.
  registrationNumber          String?  @map("registration_number") @db.VarChar(50)
  registrationNumberAbsentWhy String?  @map("registration_number_absent_why") @db.VarChar(300)
  kraPin                      String?  @map("kra_pin") @db.VarChar(20)
  kraPinAbsentWhy             String?  @map("kra_pin_absent_why") @db.VarChar(300)
  /// ISO 3166-1 alpha-2.
  country                     String   @default("KE") @db.Char(2)
  region                      String?  @db.VarChar(100)
  address                     String?  @db.VarChar(300)
  phone                       String?  @db.VarChar(20)
  contactEmail                String?  @map("contact_email") @db.Citext
  industry                    String?  @db.VarChar(100)
  employeeBand                String?  @map("employee_band") @db.VarChar(20)
  version                     Int      @default(0)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("organisation_profile")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

/// One application per organisation tenant. Decisions only through platform context (trigger).
model OrganisationApplication {
  id              String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                         @unique @map("tenant_id") @db.Uuid
  status          ApplicationStatus              @default(DRAFT)
  applicantUserId String                         @map("applicant_user_id") @db.Uuid
  submittedAt     DateTime?                      @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?                      @map("decided_at") @db.Timestamptz(6)
  decidedBy       String?                        @map("decided_by") @db.Uuid
  /// Latest reviewer reason (changes requested or rejection). Shown to the applicant.
  decisionReason  String?                        @map("decision_reason") @db.VarChar(1000)
  version         Int                            @default(0)
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events          OrganisationApplicationEvent[]

  @@index([status, submittedAt])
  @@map("organisation_application")
}

/// Append-only history of an application (trigger-protected).
model OrganisationApplicationEvent {
  id            String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  fromStatus    ApplicationStatus?      @map("from_status")
  toStatus      ApplicationStatus       @map("to_status")
  actorUserId   String?                 @map("actor_user_id") @db.Uuid
  reason        String?                 @db.VarChar(1000)
  occurredAt    DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(6)
  application   OrganisationApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
  @@map("organisation_application_event")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Email-bound, single-use, expiring invitation (review §7). Token minted by the worker; only its SHA-256 is stored.
model Invitation {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  email        String           @db.Citext
  roleIds      String[]         @map("role_ids") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  tokenHash    String?          @unique @map("token_hash") @db.Char(64)
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedBy    String           @map("invited_by") @db.Uuid
  acceptedBy   String?          @map("accepted_by") @db.Uuid
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("invitation")
}

/// Flat list of departments in an organisation (P4-5). Archived, never deleted.
model Department {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String       @db.VarChar(100)
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([tenantId, name])
  @@map("department")
}

// ---------------------------------------------------------------------------
// Providers (Phase 5). Phase 5 plan §2.
// ---------------------------------------------------------------------------

enum ProviderKind {
  COMPANY
  INDIVIDUAL
}

enum ProviderStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ExperienceBand {
  UNDER_1_YEAR
  YEARS_1_3
  YEARS_3_5
  OVER_5_YEARS
}

/// Platform-owned skill taxonomy (P5-3). Services name required skills in Phase 6.
model Skill {
  code      String          @id @db.VarChar(60)
  name      String          @db.VarChar(120)
  category  String          @db.VarChar(60)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  providers ProviderSkill[]
  services  ServiceSkill[]
  jobs      JobSkill[]

  @@map("skill")
}

/// Platform-owned geography (P5-6): the 47 counties of Kenya first (ISO 3166-2:KE).
model Region {
  code      String           @id @db.VarChar(10)
  country   String           @db.Char(2)
  name      String           @db.VarChar(100)
  active    Boolean          @default(true)
  providers ProviderRegion[]

  @@index([country])
  @@map("region")
}

/// One supply-side entity: a provider company (tenant) OR an individual (user), never both (P5-1).
model Provider {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind          ProviderKind
  /// Provider company: its tenant.
  tenantId      String?                @unique @map("tenant_id") @db.Uuid
  /// Individual provider: the person.
  ownerUserId   String?                @unique @map("owner_user_id") @db.Uuid
  displayName   String                 @map("display_name") @db.VarChar(200)
  status        ProviderStatus         @default(PENDING_APPROVAL)
  phone         String?                @db.VarChar(20)
  homeRegion    String?                @map("home_region") @db.VarChar(10)
  remoteOk      Boolean                @default(false) @map("remote_ok")
  acceptingWork Boolean                @default(true) @map("accepting_work")
  /// Data-protection retention marker (P5-5): rejected individuals may be erased after this.
  retainUntil   DateTime?              @map("retain_until") @db.Timestamptz(6)
  version       Int                    @default(0)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  skills        ProviderSkill[]
  regions       ProviderRegion[]
  workingHours  ProviderWorkingHours[]
  timeOff       ProviderTimeOff[]
  application   ProviderApplication?
  jobOffers     JobOffer[]
  assignments   JobAssignment[]

  @@map("provider")
}

model ProviderSkill {
  providerId String         @map("provider_id") @db.Uuid
  skillCode  String         @map("skill_code") @db.VarChar(60)
  experience ExperienceBand @default(YEARS_1_3)
  provider   Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  skill      Skill          @relation(fields: [skillCode], references: [code], onDelete: Restrict)

  @@id([providerId, skillCode])
  @@index([skillCode])
  @@map("provider_skill")
}

model ProviderRegion {
  providerId String   @map("provider_id") @db.Uuid
  regionCode String   @map("region_code") @db.VarChar(10)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  region     Region   @relation(fields: [regionCode], references: [code], onDelete: Restrict)

  @@id([providerId, regionCode])
  @@index([regionCode])
  @@map("provider_region")
}

/// Weekly working hours in Africa/Nairobi. ISO weekday 1 (Mon) to 7 (Sun); minutes since midnight.
model ProviderWorkingHours {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, weekday])
  @@map("provider_working_hours")
}

model ProviderTimeOff {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, startsAt])
  @@map("provider_time_off")
}

/// Same lifecycle as organisation applications (shared transition rules).
model ProviderApplication {
  id              String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId      String                     @unique @map("provider_id") @db.Uuid
  status          ApplicationStatus          @default(DRAFT)
  applicantUserId String                     @map("applicant_user_id") @db.Uuid
  submittedAt     DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?                  @map("decided_at") @db.Timestamptz(6)
  decidedBy       String?                    @map("decided_by") @db.Uuid
  decisionReason  String?                    @map("decision_reason") @db.VarChar(1000)
  version         Int                        @default(0)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider        Provider                   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  events          ProviderApplicationEvent[]
  verifications   ProviderVerification[]

  @@index([status, submittedAt])
  @@map("provider_application")
}

model ProviderApplicationEvent {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus?  @map("from_status")
  toStatus      ApplicationStatus   @map("to_status")
  actorUserId   String?             @map("actor_user_id") @db.Uuid
  reason        String?             @db.VarChar(1000)
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  application   ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
  @@map("provider_application_event")
}

/// Reviewer's structured verdict at approval (Phase 5 plan §2.2). Platform-only.
model ProviderVerification {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId       String              @map("application_id") @db.Uuid
  reviewerUserId      String              @map("reviewer_user_id") @db.Uuid
  identityChecked     Boolean             @map("identity_checked")
  registrationChecked Boolean             @map("registration_checked")
  taxChecked          Boolean             @map("tax_checked")
  skillsChecked       Boolean             @map("skills_checked")
  notes               String?             @db.VarChar(1000)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  application         ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@map("provider_verification")
}

// ---------------------------------------------------------------------------
// Phase 6: service catalogue (platform-owned, no tenant column; review §4.1).
// Hand-written SQL in the migration adds the CHECK constraints, the search
// vector trigger, the append-only price trigger and row-level security.
// ---------------------------------------------------------------------------

enum CatalogueStatus {
  ACTIVE
  ARCHIVED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ServiceAudience {
  ALL
  ORGANISATIONS
  INDIVIDUALS
}

enum DeliveryMode {
  ON_SITE
  REMOTE
  BOTH
}

enum PriceModel {
  FIXED
  PER_UNIT
  FROM
  QUOTE
}

enum PriceUnit {
  HOUR
  DEVICE
  USER
  VISIT
  POINT
}

/// Two-level tree (top level and one level below). Slug fixed at creation.
model ServiceCategory {
  id        String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentId  String?           @map("parent_id") @db.Uuid
  slug      String            @unique @db.VarChar(80)
  name      String            @db.VarChar(120)
  summary   String?           @db.VarChar(300)
  icon      String            @default("folder") @db.VarChar(40)
  position  Int               @default(0)
  status    CatalogueStatus   @default(ACTIVE)
  version   Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ServiceCategory[] @relation("CategoryTree")
  services  Service[]

  @@index([parentId, position])
  @@map("service_category")
}

model Service {
  id                   String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId           String                   @map("category_id") @db.Uuid
  /// Immutable once the service has been published (trigger).
  slug                 String                   @unique @db.VarChar(100)
  name                 String                   @db.VarChar(150)
  summary              String                   @default("") @db.VarChar(300)
  /// Plain text; paragraphs separated by blank lines. Never rendered as HTML.
  description          String                   @default("")
  inclusions           String[]                 @default([])
  exclusions           String[]                 @default([])
  customerRequirements String[]                 @default([]) @map("customer_requirements")
  typicalDuration      String?                  @map("typical_duration") @db.VarChar(100)
  audience             ServiceAudience          @default(ALL)
  deliveryMode         DeliveryMode             @default(ON_SITE) @map("delivery_mode")
  channelOgs           Boolean                  @default(true) @map("channel_ogs")
  channelIndividual    Boolean                  @default(true) @map("channel_individual")
  channelCompany       Boolean                  @default(true) @map("channel_company")
  status               ServiceStatus            @default(DRAFT)
  publishedAt          DateTime?                @map("published_at") @db.Timestamptz(6)
  retiredAt            DateTime?                @map("retired_at") @db.Timestamptz(6)
  createdBy            String?                  @map("created_by") @db.Uuid
  version              Int                      @default(0)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Maintained by trigger (name unstemmed + stemmed English text); GIN index in SQL.
  searchVector         Unsupported("tsvector")? @map("search_vector")
  category             ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices               ServicePrice[]
  skills               ServiceSkill[]
  requests             ServiceRequest[]
  jobs                 Job[]

  @@index([categoryId, status])
  @@index([status, name])
  @@index([searchVector], map: "service_search_vector_idx", type: Gin)
  @@map("service")
}

/// Append-only price versions (P6-3). Amounts in integer minor units (cents), excluding VAT (P6-8).
model ServicePrice {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceId     String           @map("service_id") @db.Uuid
  model         PriceModel
  amountMinor   BigInt?          @map("amount_minor")
  currency      String           @default("KES") @db.Char(3)
  unit          PriceUnit?
  minQuantity   Int              @default(1) @map("min_quantity")
  effectiveFrom DateTime         @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdBy     String?          @map("created_by") @db.Uuid
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  requests      ServiceRequest[]

  @@index([serviceId, effectiveFrom])
  @@map("service_price")
}

model ServiceSkill {
  serviceId     String         @map("service_id") @db.Uuid
  skillCode     String         @map("skill_code") @db.VarChar(60)
  minExperience ExperienceBand @default(UNDER_1_YEAR) @map("min_experience")
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  skill         Skill          @relation(fields: [skillCode], references: [code], onDelete: Restrict)

  @@id([serviceId, skillCode])
  @@index([skillCode])
  @@map("service_skill")
}

// ---------------------------------------------------------------------------
// Phase 7: service requests, quotations, orders, manual payments.
// Commercial records belong to an organisation OR a person (ADR-009): exactly
// one of customer_tenant_id / customer_user_id is set (CHECK in SQL).
// Hand-written SQL adds CHECKs, transition guards, append-only triggers and RLS.
// ---------------------------------------------------------------------------

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_QUOTATION
  QUOTATION_ISSUED
  ORDERED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  READY_FOR_ASSIGNMENT
  /// Phase 9 (P9-10): the job was accepted by an assignee.
  IN_DELIVERY
  /// Phase 9 (P9-10): the job was confirmed.
  COMPLETED
  CANCELLED
}

enum PaymentTerms {
  PREPAY
  POSTPAID
}

enum PaymentMethod {
  BANK_TRANSFER
  MPESA_PAYBILL
}

model ServiceRequest {
  id               String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  number           String                @unique @db.VarChar(20)
  customerTenantId String?               @map("customer_tenant_id") @db.Uuid
  customerUserId   String?               @map("customer_user_id") @db.Uuid
  createdBy        String                @map("created_by") @db.Uuid
  serviceId        String                @map("service_id") @db.Uuid
  /// Snapshot of the catalogue price at submission: never re-read.
  servicePriceId   String                @map("service_price_id") @db.Uuid
  serviceName      String                @map("service_name") @db.VarChar(150)
  priceModel       PriceModel            @map("price_model")
  unitAmountMinor  BigInt?               @map("unit_amount_minor")
  priceUnit        PriceUnit?            @map("price_unit")
  quantity         Int                   @default(1)
  county           String                @db.VarChar(10)
  address          String                @db.VarChar(300)
  preferredFrom    DateTime?             @map("preferred_from") @db.Date
  preferredTo      DateTime?             @map("preferred_to") @db.Date
  description      String                @default("") @db.VarChar(2000)
  contactPhone     String                @map("contact_phone") @db.VarChar(20)
  /// Entered by OGS staff for the customer (Phase 8, P8-7); `enteredBy` is the staff member.
  onBehalf         Boolean               @default(false) @map("on_behalf")
  enteredBy        String?               @map("entered_by") @db.Uuid
  status           RequestStatus         @default(SUBMITTED)
  cancelReason     String?               @map("cancel_reason") @db.VarChar(500)
  version          Int                   @default(0)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  service          Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  servicePrice     ServicePrice          @relation(fields: [servicePriceId], references: [id], onDelete: Restrict)
  events           ServiceRequestEvent[]
  quotations       Quotation[]
  order            ServiceOrder?

  @@index([customerTenantId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
  @@map("service_request")
}

/// Append-only history: one row per transition (review §9).
model ServiceRequestEvent {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId   String         @map("request_id") @db.Uuid
  fromStatus  RequestStatus? @map("from_status")
  toStatus    RequestStatus  @map("to_status")
  command     String         @db.VarChar(40)
  actorUserId String?        @default(dbgenerated("app.current_user_id()")) @map("actor_user_id") @db.Uuid
  reason      String?        @db.VarChar(500)
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, occurredAt])
  @@map("service_request_event")
}

model Quotation {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  number         String          @unique @db.VarChar(20)
  requestId      String          @map("request_id") @db.Uuid
  revision       Int
  status         QuotationStatus @default(DRAFT)
  validDays      Int             @default(14) @map("valid_days")
  notes          String          @default("") @db.VarChar(2000)
  subtotalMinor  BigInt          @default(0) @map("subtotal_minor")
  vatMinor       BigInt          @default(0) @map("vat_minor")
  totalMinor     BigInt          @default(0) @map("total_minor")
  issuedAt       DateTime?       @map("issued_at") @db.Timestamptz(6)
  expiresAt      DateTime?       @map("expires_at") @db.Timestamptz(6)
  decidedAt      DateTime?       @map("decided_at") @db.Timestamptz(6)
  decisionReason String?         @map("decision_reason") @db.VarChar(500)
  createdBy      String          @map("created_by") @db.Uuid
  version        Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  request        ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  lines          QuotationLine[]
  order          ServiceOrder?

  @@unique([requestId, revision])
  @@index([status, expiresAt])
  @@map("quotation")
}

model QuotationLine {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  quotationId     String    @map("quotation_id") @db.Uuid
  position        Int
  description     String    @db.VarChar(300)
  quantity        Int
  unitAmountMinor BigInt    @map("unit_amount_minor")
  netMinor        BigInt    @map("net_minor")
  vatMinor        BigInt    @map("vat_minor")
  totalMinor      BigInt    @map("total_minor")
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)

  @@unique([quotationId, position])
  @@map("quotation_line")
}

model ServiceOrder {
  id               String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  number           String              @unique @db.VarChar(20)
  requestId        String              @unique @map("request_id") @db.Uuid
  quotationId      String?             @unique @map("quotation_id") @db.Uuid
  customerTenantId String?             @map("customer_tenant_id") @db.Uuid
  customerUserId   String?             @map("customer_user_id") @db.Uuid
  paymentTerms     PaymentTerms        @map("payment_terms")
  netDays          Int?                @map("net_days")
  subtotalMinor    BigInt              @map("subtotal_minor")
  vatMinor         BigInt              @map("vat_minor")
  totalMinor       BigInt              @map("total_minor")
  paidMinor        BigInt              @default(0) @map("paid_minor")
  status           OrderStatus
  refundDue        Boolean             @default(false) @map("refund_due")
  cancelReason     String?             @map("cancel_reason") @db.VarChar(500)
  version          Int                 @default(0)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  request          ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quotation        Quotation?          @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  events           ServiceOrderEvent[]
  payments         Payment[]
  tickets          Ticket[]
  job              Job?

  @@index([customerTenantId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
  @@map("service_order")
}

model ServiceOrderEvent {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  command     String       @db.VarChar(40)
  actorUserId String?      @default(dbgenerated("app.current_user_id()")) @map("actor_user_id") @db.Uuid
  reason      String?      @db.VarChar(500)
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, occurredAt])
  @@map("service_order_event")
}

/// Manual payments (ADR-015 item 3): append-only, recorded by finance.
model Payment {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  amountMinor BigInt        @map("amount_minor")
  method      PaymentMethod
  reference   String        @db.VarChar(60)
  note        String?       @db.VarChar(300)
  recordedBy  String?       @default(dbgenerated("app.current_user_id()")) @map("recorded_by") @db.Uuid
  recordedAt  DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(6)
  order       ServiceOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([method, reference])
  @@index([orderId])
  @@map("payment")
}

/// Payment terms per organisation (P7-5), set by finance.
model OrganisationBilling {
  tenantId     String       @id @map("tenant_id") @db.Uuid
  paymentTerms PaymentTerms @default(PREPAY) @map("payment_terms")
  netDays      Int?         @map("net_days")
  version      Int          @default(0)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("organisation_billing")
}

/// Idempotency-Key records (P7-7), visible only to their own user.
model IdempotencyKey {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key            String   @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  scope          String   @db.VarChar(60)
  route          String   @db.VarChar(120)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([userId, scope, route, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}

/// Yearly document counters (P7-8): REQ / QUO / ORD, and TCK (Phase 8).
model DocumentCounter {
  kind String @db.VarChar(3)
  year Int
  last Int    @default(0)

  @@id([kind, year])
  @@map("document_counter")
}

// ---------------------------------------------------------------------------
// Phase 8: tickets (ITSM). A ticket belongs to an organisation OR a person
// (ADR-009). Public conversation and staff-only internal notes live in separate
// tables (P8-5): internal notes have no customer RLS branch at all.
// Hand-written SQL adds CHECKs, transition guards, append-only triggers and RLS.
// ---------------------------------------------------------------------------

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  AWAITING_CUSTOMER
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketType {
  INCIDENT
  QUESTION
}

/// What the customer says (P8-3).
enum TicketUrgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

/// What staff decide at triage (P8-3); Phase 10 SLA targets key on it.
enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum TicketChannel {
  WEB
  PHONE
  EMAIL
  WALK_IN
  WHATSAPP
}

enum TicketClosure {
  ACCEPTED
  AUTO_CLOSED
  WITHDRAWN
}

enum TicketAuthorSide {
  CUSTOMER
  STAFF
}

enum TicketEventVisibility {
  PUBLIC
  INTERNAL
}

/// Platform-owned list (seeded); edited in Phase 14 admin.
model TicketCategory {
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code     String   @unique @db.VarChar(40)
  name     String   @db.VarChar(80)
  position Int
  active   Boolean  @default(true)
  tickets  Ticket[]

  @@map("ticket_category")
}

model Ticket {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  number           String               @unique @db.VarChar(20)
  customerTenantId String?              @map("customer_tenant_id") @db.Uuid
  customerUserId   String?              @map("customer_user_id") @db.Uuid
  /// The person the ticket is for (the customer, or the organisation member).
  requesterUserId  String               @map("requester_user_id") @db.Uuid
  /// Snapshot of the requester's department at creation (P8-4).
  departmentId     String?              @map("department_id") @db.Uuid
  createdBy        String               @map("created_by") @db.Uuid
  onBehalf         Boolean              @default(false) @map("on_behalf")
  channel          TicketChannel        @default(WEB)
  type             TicketType           @default(INCIDENT)
  categoryId       String               @map("category_id") @db.Uuid
  subject          String               @db.VarChar(150)
  description      String               @db.VarChar(5000)
  urgency          TicketUrgency        @default(NORMAL)
  priority         TicketPriority?
  serviceOrderId   String?              @map("service_order_id") @db.Uuid
  relatedTicketId  String?              @map("related_ticket_id") @db.Uuid
  /// The OGS staff member who owns the ticket (P8-1). Never shown to customers.
  assigneeUserId   String?              @map("assignee_user_id") @db.Uuid
  status           TicketStatus         @default(NEW)
  /// Shown to the customer: what was done.
  resolution       String?              @db.VarChar(2000)
  closure          TicketClosure?
  closureReason    String?              @map("closure_reason") @db.VarChar(500)
  reopenCount      Int                  @default(0) @map("reopen_count")
  firstResponseAt  DateTime?            @map("first_response_at") @db.Timestamptz(6)
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(6)
  closedAt         DateTime?            @map("closed_at") @db.Timestamptz(6)
  version          Int                  @default(0)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category         TicketCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  serviceOrder     ServiceOrder?        @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  relatedTicket    Ticket?              @relation("TicketFollowUp", fields: [relatedTicketId], references: [id], onDelete: Restrict)
  followUps        Ticket[]             @relation("TicketFollowUp")
  comments         TicketComment[]
  internalNotes    TicketInternalNote[]
  attachments      TicketAttachment[]
  events           TicketEvent[]
  jobs             Job[]

  @@index([customerTenantId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([status, priority, createdAt])
  @@index([assigneeUserId, status])
  @@index([status, resolvedAt])
  @@map("ticket")
}

/// The public conversation. Append-only.
model TicketComment {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId     String             @map("ticket_id") @db.Uuid
  authorUserId String             @default(dbgenerated("app.current_user_id()")) @map("author_user_id") @db.Uuid
  side         TicketAuthorSide
  body         String             @db.VarChar(5000)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  attachments  TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_comment")
}

/// Staff-only notes (P8-5). RLS: platform staff only. Append-only.
model TicketInternalNote {
  id           String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId     String             @map("ticket_id") @db.Uuid
  authorUserId String             @default(dbgenerated("app.current_user_id()")) @map("author_user_id") @db.Uuid
  body         String             @db.VarChar(5000)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  attachments  TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_internal_note")
}

/// A file on the ticket itself (both NULL), a public comment, or an internal note (CHECK: not both).
model TicketAttachment {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId  String              @map("ticket_id") @db.Uuid
  fileId    String              @unique @map("file_id") @db.Uuid
  commentId String?             @map("comment_id") @db.Uuid
  noteId    String?             @map("note_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  ticket    Ticket              @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  comment   TicketComment?      @relation(fields: [commentId], references: [id], onDelete: Restrict)
  note      TicketInternalNote? @relation(fields: [noteId], references: [id], onDelete: Restrict)
  file      FileMetadata        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_attachment")
}

/// Append-only activity log: one row per command (review §13 "activity log complete").
model TicketEvent {
  id          String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ticketId    String                @map("ticket_id") @db.Uuid
  kind        String                @db.VarChar(30)
  /// INTERNAL rows (notes, priority, assignee, holds) are invisible to customers in RLS.
  visibility  TicketEventVisibility
  fromValue   String?               @map("from_value") @db.VarChar(40)
  toValue     String?               @map("to_value") @db.VarChar(40)
  actorUserId String?               @default(dbgenerated("app.current_user_id()")) @map("actor_user_id") @db.Uuid
  reason      String?               @db.VarChar(2000)
  occurredAt  DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(6)
  ticket      Ticket                @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, occurredAt])
  @@map("ticket_event")
}

// ---------------------------------------------------------------------------
// Phase 9: jobs, offers, assignments and field work (Phase 9 plan §2).
// A job copies its customer owner (ADR-009) and everything a provider may know
// (the brief, P9-1), so providers never need a policy on any customer table.
// Hand-written SQL adds CHECKs, eligibility (app.can_take_job), transition
// guards, append-only triggers and RLS.
// ---------------------------------------------------------------------------

enum JobStatus {
  QUEUED
  OFFERED
  ASSIGNED
  ON_THE_WAY
  IN_PROGRESS
  PAUSED
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
}

enum AssigneeKind {
  INTERNAL
  INDIVIDUAL
  COMPANY
}

enum JobOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum DeclineReason {
  NOT_AVAILABLE
  TOO_FAR
  LACKS_SKILLS
  WORKLOAD
  OTHER
}

enum JobAssignmentStatus {
  ACTIVE
  ENDED
}

enum AssignmentEndReason {
  REASSIGNED
  REMOVED
  TECHNICIAN_CHANGED
  JOB_COMPLETED
  JOB_CANCELLED
  PROVIDER_SUSPENDED
}

enum CompletionOutcome {
  CONFIRMED
  ISSUE_RAISED
  AUTO_CONFIRMED
  STAFF_CONFIRMED
}

/// A piece of dispatchable work: from an order (one per order) or a ticket.
model Job {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  number           String          @unique @db.VarChar(20)
  serviceOrderId   String?         @unique @map("service_order_id") @db.Uuid
  ticketId         String?         @map("ticket_id") @db.Uuid
  customerTenantId String?         @map("customer_tenant_id") @db.Uuid
  customerUserId   String?         @map("customer_user_id") @db.Uuid
  /// Organisation name, or "Private customer" (there is no personal name field).
  customerDisplay  String          @map("customer_display") @db.VarChar(200)
  serviceId        String?         @map("service_id") @db.Uuid
  title            String          @db.VarChar(150)
  /// Requirements copied at creation (P9-11): channels, remote, county; skills in job_skill.
  allowInternal    Boolean         @default(true) @map("allow_internal")
  allowIndividual  Boolean         @default(true) @map("allow_individual")
  allowCompany     Boolean         @default(true) @map("allow_company")
  onSite           Boolean         @default(true) @map("on_site")
  remoteAllowed    Boolean         @default(false) @map("remote_allowed")
  regionCode       String          @map("region_code") @db.VarChar(10)
  /// The provider-facing brief, written by OGS (P9-1). Never shown to customers.
  brief            String          @default("") @db.VarChar(4000)
  siteAddress      String          @map("site_address") @db.VarChar(300)
  siteContactName  String?         @map("site_contact_name") @db.VarChar(100)
  siteContactPhone String?         @map("site_contact_phone") @db.VarChar(20)
  windowFrom       DateTime?       @map("window_from") @db.Date
  windowTo         DateTime?       @map("window_to") @db.Date
  status           JobStatus       @default(QUEUED)
  version          Int             @default(0)
  assignedAt       DateTime?       @map("assigned_at") @db.Timestamptz(6)
  startedAt        DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  confirmedAt      DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  cancelReason     String?         @map("cancel_reason") @db.VarChar(500)
  createdBy        String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceOrder     ServiceOrder?   @relation(fields: [serviceOrderId], references: [id], onDelete: Restrict)
  ticket           Ticket?         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  service          Service?        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  skills           JobSkill[]
  offers           JobOffer[]
  assignments      JobAssignment[]
  events           JobEvent[]
  workNotes        JobWorkNote[]
  evidence         JobEvidence[]
  completions      JobCompletion[]

  @@index([status, createdAt])
  @@index([customerTenantId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([ticketId])
  @@map("job")
}

model JobSkill {
  jobId         String         @map("job_id") @db.Uuid
  skillCode     String         @map("skill_code") @db.VarChar(60)
  minExperience ExperienceBand @default(UNDER_1_YEAR) @map("min_experience")
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  skill         Skill          @relation(fields: [skillCode], references: [code], onDelete: Restrict)

  @@id([jobId, skillCode])
  @@map("job_skill")
}

/// An offer to one assignee (P9-4: one PENDING offer per job, partial unique index in SQL).
model JobOffer {
  id               String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId            String          @map("job_id") @db.Uuid
  kind             AssigneeKind
  /// Individual or company offers: the provider.
  providerId       String?         @map("provider_id") @db.Uuid
  /// The PLATFORM tenant (internal) or the company's tenant. Null for individuals.
  assigneeTenantId String?         @map("assignee_tenant_id") @db.Uuid
  /// Internal offers: the technician.
  technicianUserId String?         @map("technician_user_id") @db.Uuid
  offeredBy        String          @default(dbgenerated("app.current_user_id()")) @map("offered_by") @db.Uuid
  offeredAt        DateTime        @default(now()) @map("offered_at") @db.Timestamptz(6)
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(6)
  status           JobOfferStatus  @default(PENDING)
  declineReason    DeclineReason?  @map("decline_reason")
  declineNote      String?         @map("decline_note") @db.VarChar(500)
  respondedBy      String?         @map("responded_by") @db.Uuid
  respondedAt      DateTime?       @map("responded_at") @db.Timestamptz(6)
  version          Int             @default(0)
  job              Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  provider         Provider?       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  assignments      JobAssignment[]

  @@index([jobId, offeredAt])
  @@index([status, expiresAt])
  @@index([providerId, status])
  @@index([assigneeTenantId, status])
  @@index([technicianUserId, status])
  @@map("job_offer")
}

/// Who holds a job (one ACTIVE row per job, partial unique index in SQL). Ending
/// the row ends the holder's access in the same transaction (plan §2.2).
model JobAssignment {
  id               String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId            String               @map("job_id") @db.Uuid
  offerId          String               @map("offer_id") @db.Uuid
  /// Copies for the assignee's "Done" list, which outlives access to the job.
  jobNumber        String               @map("job_number") @db.VarChar(20)
  title            String               @db.VarChar(150)
  /// Copied from the job for RLS (no policy here reads "job": no recursion).
  customerTenantId String?              @map("customer_tenant_id") @db.Uuid
  customerUserId   String?              @map("customer_user_id") @db.Uuid
  kind             AssigneeKind
  providerId       String?              @map("provider_id") @db.Uuid
  assigneeTenantId String?              @map("assignee_tenant_id") @db.Uuid
  /// The person doing the work.
  technicianUserId String               @map("technician_user_id") @db.Uuid
  /// What the customer sees (P9-8): a first name only, copied when assigned.
  technicianName   String?              @map("technician_name") @db.VarChar(60)
  status           JobAssignmentStatus  @default(ACTIVE)
  endReason        AssignmentEndReason? @map("end_reason")
  endNote          String?              @map("end_note") @db.VarChar(500)
  startedAt        DateTime             @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime?            @map("ended_at") @db.Timestamptz(6)
  endedBy          String?              @map("ended_by") @db.Uuid
  job              Job                  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  offer            JobOffer             @relation(fields: [offerId], references: [id], onDelete: Restrict)
  provider         Provider?            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  events           JobEvent[]
  workNotes        JobWorkNote[]
  evidence         JobEvidence[]
  completions      JobCompletion[]

  @@index([jobId, startedAt])
  @@index([providerId, status])
  @@index([assigneeTenantId, status])
  @@index([technicianUserId, status])
  @@map("job_assignment")
}

/// Append-only activity: one row per command. Audience flags are read by RLS.
model JobEvent {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId           String         @map("job_id") @db.Uuid
  /// The assignment the event belongs to (provider-visible rows need one).
  assignmentId    String?        @map("assignment_id") @db.Uuid
  kind            String         @db.VarChar(30)
  fromValue       String?        @map("from_value") @db.VarChar(40)
  toValue         String?        @map("to_value") @db.VarChar(40)
  actorUserId     String?        @default(dbgenerated("app.current_user_id()")) @map("actor_user_id") @db.Uuid
  reason          String?        @db.VarChar(2000)
  customerVisible Boolean        @default(false) @map("customer_visible")
  providerVisible Boolean        @default(false) @map("provider_visible")
  occurredAt      DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  job             Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignment      JobAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([jobId, occurredAt])
  @@index([assignmentId])
  @@map("job_event")
}

/// Notes by the assignee's side or staff (P9-9: belong to one assignment). Never customer-visible.
model JobWorkNote {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId        String        @map("job_id") @db.Uuid
  assignmentId String        @map("assignment_id") @db.Uuid
  authorUserId String        @default(dbgenerated("app.current_user_id()")) @map("author_user_id") @db.Uuid
  body         String        @db.VarChar(4000)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignment   JobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assignmentId, createdAt])
  @@index([jobId])
  @@map("job_work_note")
}

/// Photo evidence (`job.evidence` files, owned by the customer). Append-only.
model JobEvidence {
  id           String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId        String        @map("job_id") @db.Uuid
  assignmentId String        @map("assignment_id") @db.Uuid
  fileId       String        @unique @map("file_id") @db.Uuid
  caption      String        @default("") @db.VarChar(200)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  job          Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignment   JobAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  file         FileMetadata  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([assignmentId, createdAt])
  @@index([jobId])
  @@map("job_evidence")
}

/// A completion report, then the customer's (or the system's, or staff's) decision.
model JobCompletion {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId          String             @map("job_id") @db.Uuid
  assignmentId   String             @map("assignment_id") @db.Uuid
  /// Customer-facing summary of the work.
  summary        String             @db.VarChar(2000)
  minutesOnSite  Int?               @map("minutes_on_site")
  materials      String             @default("") @db.VarChar(1000)
  evidenceIds    String[]           @default([]) @map("evidence_ids") @db.Uuid
  submittedBy    String             @default(dbgenerated("app.current_user_id()")) @map("submitted_by") @db.Uuid
  submittedAt    DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  outcome        CompletionOutcome?
  decidedBy      String?            @map("decided_by") @db.Uuid
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(6)
  decisionReason String?            @map("decision_reason") @db.VarChar(500)
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignment     JobAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([jobId, submittedAt])
  @@map("job_completion")
}
