// OGS Prisma schema.
//
// Prisma does not model row-level security, policies, triggers, grants, CHECK
// constraints or partial indexes. Those live as hand-written SQL in the migration
// files (create migrations with `pnpm db:migrate:dev --create-only`, then edit).
// The RLS catalogue test (test/integration/rls-catalogue.int.test.ts) fails CI if a
// table is added without RLS + FORCE + a policy.
//
// Connection settings live in ../prisma.config.ts (DATABASE_MIGRATION_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy (Phase 2). Review §5, ADR-009.
// ---------------------------------------------------------------------------

enum TenantKind {
  ORGANISATION
  PROVIDER_COMPANY
  PLATFORM
}

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

/// An organisation, a provider company, or the single PLATFORM tenant (OGS staff).
model Tenant {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind        TenantKind
  status      TenantStatus     @default(PENDING_APPROVAL)
  name        String           @db.VarChar(200)
  /// Lower-case, URL-safe, globally unique (CHECK in SQL).
  slug        String           @unique @db.VarChar(100)
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz(6)
  memberships Membership[]
  roles       Role[]
  memberRoles MembershipRole[]

  @@map("tenant")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// One row per human (review §7). Phase 2 is deliberately minimal: credentials,
/// profile and MFA are added in Phase 3.
model AppUser {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email       String       @unique @db.Citext
  status      UserStatus   @default(PENDING_VERIFICATION)
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)
  memberships Membership[]
  credential  Credential?
  tokens      UserToken[]

  @@map("app_user")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

/// A user's capacity inside a tenant. Roles and departments arrive in Phases 3–4.
model Membership {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(INVITED)
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz(6)
  endedAt   DateTime?        @map("ended_at") @db.Timestamptz(6)
  version   Int              @default(0)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles     MembershipRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Cross-cutting foundations moved into Phase 2 (ADR-015).
// ---------------------------------------------------------------------------

enum ActorKind {
  USER
  SYSTEM
}

/// Append-only. UPDATE/DELETE/TRUNCATE are rejected by trigger for every role.
/// No foreign keys on purpose: the log must outlive and never block the rows it describes.
/// actor_user_id and actor_kind are filled from the transaction's context and an
/// RLS check rejects any other value, so callers cannot spoof the actor.
model AuditLog {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorKind   ActorKind @default(dbgenerated("app.current_actor_kind()")) @map("actor_kind")
  actorUserId String?   @default(dbgenerated("app.current_user_id()")) @map("actor_user_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  action      String    @db.VarChar(100)
  entityType  String?   @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.VarChar(100)
  reason      String?   @db.VarChar(500)
  requestId   String?   @map("request_id") @db.VarChar(100)
  ip          String?   @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  metadata    Json      @default("{}")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

/// Transactional outbox (review §3). Written in the same transaction as the
/// business change; read and marked dispatched only under the `system` context.
model OutboxEvent {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         String    @db.VarChar(150)
  tenantId     String?   @map("tenant_id") @db.Uuid
  payload      Json
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") @db.VarChar(2000)

  @@index([dispatchedAt, availableAt])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------
// Identity (Phase 3A). Review §7, ADR-011, Phase 3 plan §2.
// Reached only under `system` context with an `identity.*` job (see RLS in
// the migration): login and registration happen before any user context exists.
// ---------------------------------------------------------------------------

/// One password credential per user. Argon2id PHC string (parameters inside).
model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credential")
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use emailed tokens. Only the SHA-256 of the token is stored.
model UserToken {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    UserTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user       AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_token")
}

enum AuthEventKind {
  REGISTERED
  REGISTER_EXISTING_EMAIL
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  SESSION_REVOKED
}

/// Append-only security log of authentication activity (trigger-protected).
model AuthenticationEvent {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  kind       AuthEventKind
  userId     String?       @map("user_id") @db.Uuid
  /// SHA-256 of the normalised email, to correlate attacks on unknown accounts without storing them.
  emailHash  String?       @map("email_hash") @db.Char(64)
  reason     String?       @db.VarChar(100)
  ip         String?       @db.Inet
  userAgent  String?       @map("user_agent") @db.VarChar(500)
  requestId  String?       @map("request_id") @db.VarChar(100)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([emailHash, occurredAt(sort: Desc)])
  @@map("authentication_event")
}

enum DeliveryStatus {
  PENDING
  SENT
}

/// Idempotency record for outbound notifications: one row per outbox event.
model NotificationDelivery {
  eventId   String         @id @map("event_id") @db.Uuid
  kind      String         @db.VarChar(100)
  userId    String?        @map("user_id") @db.Uuid
  status    DeliveryStatus @default(PENDING)
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("notification_delivery")
}

// ---------------------------------------------------------------------------
// Authorisation (Phase 3A). Review §8. System roles and permissions are synced
// from src/authz/catalogue.json; organisations may add custom roles.
// ---------------------------------------------------------------------------

/// Platform-defined permission code, usable only in the listed tenant kinds.
model Permission {
  code         String           @id @db.VarChar(100)
  description  String           @db.VarChar(300)
  allowedKinds TenantKind[]     @map("allowed_kinds")
  roles        RolePermission[]

  @@map("permission")
}

model Role {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null for system roles; the owning tenant for custom roles.
  tenantId    String?          @map("tenant_id") @db.Uuid
  /// The tenant kind this role may be granted in.
  scope       TenantKind
  code        String           @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.VarChar(300)
  isSystem    Boolean          @default(false) @map("is_system")
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  memberships MembershipRole[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Custom roles: unique per tenant. System roles (tenant_id NULL): partial unique index in SQL.
  @@unique([tenantId, code])
  @@map("role")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

/// A role granted to a membership. tenant_id is denormalised for RLS and kept
/// consistent with the membership by trigger.
model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("membership_role")
}
