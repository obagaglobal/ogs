// OGS Prisma schema.
//
// Prisma does not model row-level security, policies, triggers, grants, CHECK
// constraints or partial indexes. Those live as hand-written SQL in the migration
// files (create migrations with `pnpm db:migrate:dev --create-only`, then edit).
// The RLS catalogue test (test/integration/rls-catalogue.int.test.ts) fails CI if a
// table is added without RLS + FORCE + a policy.
//
// Connection settings live in ../prisma.config.ts (DATABASE_MIGRATION_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy (Phase 2). Review §5, ADR-009.
// ---------------------------------------------------------------------------

enum TenantKind {
  ORGANISATION
  PROVIDER_COMPANY
  PLATFORM
}

enum TenantStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
  CLOSED
}

/// An organisation, a provider company, or the single PLATFORM tenant (OGS staff).
model Tenant {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind                    TenantKind
  status                  TenantStatus             @default(PENDING_APPROVAL)
  name                    String                   @db.VarChar(200)
  /// Lower-case, URL-safe, globally unique (CHECK in SQL).
  slug                    String                   @unique @db.VarChar(100)
  version                 Int                      @default(0)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                @map("deleted_at") @db.Timestamptz(6)
  memberships             Membership[]
  roles                   Role[]
  memberRoles             MembershipRole[]
  organisationProfile     OrganisationProfile?
  organisationApplication OrganisationApplication?
  invitations             Invitation[]
  departments             Department[]

  @@map("tenant")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

/// One row per human (review §7). Phase 2 is deliberately minimal: credentials,
/// profile and MFA are added in Phase 3.
model AppUser {
  id            String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email         String         @unique @db.Citext
  status        UserStatus     @default(PENDING_VERIFICATION)
  /// True once a TOTP factor is confirmed (kept in step by identity jobs; read by the access guard).
  mfaEnabled    Boolean        @default(false) @map("mfa_enabled")
  version       Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  memberships   Membership[]
  credential    Credential?
  tokens        UserToken[]
  mfaFactor     MfaFactor?
  recoveryCodes RecoveryCode[]

  @@map("app_user")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ENDED
}

/// A user's capacity inside a tenant. Roles and departments arrive in Phases 3–4.
model Membership {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  status       MembershipStatus @default(INVITED)
  joinedAt     DateTime?        @map("joined_at") @db.Timestamptz(6)
  endedAt      DateTime?        @map("ended_at") @db.Timestamptz(6)
  version      Int              @default(0)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        MembershipRole[]
  /// Optional department (organisations only, Phase 4).
  departmentId String?          @map("department_id") @db.Uuid
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("membership")
}

// ---------------------------------------------------------------------------
// Cross-cutting foundations moved into Phase 2 (ADR-015).
// ---------------------------------------------------------------------------

enum ActorKind {
  USER
  SYSTEM
}

/// Append-only. UPDATE/DELETE/TRUNCATE are rejected by trigger for every role.
/// No foreign keys on purpose: the log must outlive and never block the rows it describes.
/// actor_user_id and actor_kind are filled from the transaction's context and an
/// RLS check rejects any other value, so callers cannot spoof the actor.
model AuditLog {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorKind   ActorKind @default(dbgenerated("app.current_actor_kind()")) @map("actor_kind")
  actorUserId String?   @default(dbgenerated("app.current_user_id()")) @map("actor_user_id") @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  action      String    @db.VarChar(100)
  entityType  String?   @map("entity_type") @db.VarChar(100)
  entityId    String?   @map("entity_id") @db.VarChar(100)
  reason      String?   @db.VarChar(500)
  requestId   String?   @map("request_id") @db.VarChar(100)
  ip          String?   @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  metadata    Json      @default("{}")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_log")
}

/// Transactional outbox (review §3). Written in the same transaction as the
/// business change; read and marked dispatched only under the `system` context.
model OutboxEvent {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type         String    @db.VarChar(150)
  tenantId     String?   @map("tenant_id") @db.Uuid
  payload      Json
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt  DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error") @db.VarChar(2000)

  @@index([dispatchedAt, availableAt])
  @@map("outbox_event")
}

// ---------------------------------------------------------------------------
// Identity (Phase 3A). Review §7, ADR-011, Phase 3 plan §2.
// Reached only under `system` context with an `identity.*` job (see RLS in
// the migration): login and registration happen before any user context exists.
// ---------------------------------------------------------------------------

/// One password credential per user. Argon2id PHC string (parameters inside).
model Credential {
  userId            String    @id @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("credential")
}

enum UserTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Single-use emailed tokens. Only the SHA-256 of the token is stored.
model UserToken {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    UserTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user       AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("user_token")
}

enum AuthEventKind {
  REGISTERED
  REGISTER_EXISTING_EMAIL
  EMAIL_VERIFIED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_LOCKED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  SESSION_REVOKED
  MFA_ENABLED
  MFA_DISABLED
  MFA_VERIFIED
  MFA_FAILED
  RECOVERY_CODE_USED
  RECOVERY_CODES_REGENERATED
}

/// Append-only security log of authentication activity (trigger-protected).
model AuthenticationEvent {
  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)
  kind       AuthEventKind
  userId     String?       @map("user_id") @db.Uuid
  /// SHA-256 of the normalised email, to correlate attacks on unknown accounts without storing them.
  emailHash  String?       @map("email_hash") @db.Char(64)
  reason     String?       @db.VarChar(100)
  ip         String?       @db.Inet
  userAgent  String?       @map("user_agent") @db.VarChar(500)
  requestId  String?       @map("request_id") @db.VarChar(100)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([emailHash, occurredAt(sort: Desc)])
  @@map("authentication_event")
}

enum DeliveryStatus {
  PENDING
  SENT
}

/// Idempotency record for outbound notifications: one row per outbox event.
model NotificationDelivery {
  eventId   String         @id @map("event_id") @db.Uuid
  kind      String         @db.VarChar(100)
  userId    String?        @map("user_id") @db.Uuid
  status    DeliveryStatus @default(PENDING)
  sentAt    DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("notification_delivery")
}

// ---------------------------------------------------------------------------
// Authorisation (Phase 3A). Review §8. System roles and permissions are synced
// from src/authz/catalogue.json; organisations may add custom roles.
// ---------------------------------------------------------------------------

/// Platform-defined permission code, usable only in the listed tenant kinds.
model Permission {
  code         String           @id @db.VarChar(100)
  description  String           @db.VarChar(300)
  allowedKinds TenantKind[]     @map("allowed_kinds")
  roles        RolePermission[]

  @@map("permission")
}

model Role {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null for system roles; the owning tenant for custom roles.
  tenantId    String?          @map("tenant_id") @db.Uuid
  /// The tenant kind this role may be granted in.
  scope       TenantKind
  code        String           @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.VarChar(300)
  isSystem    Boolean          @default(false) @map("is_system")
  version     Int              @default(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  memberships MembershipRole[]
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Custom roles: unique per tenant. System roles (tenant_id NULL): partial unique index in SQL.
  @@unique([tenantId, code])
  @@map("role")
}

model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code") @db.VarChar(100)
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

/// A role granted to a membership. tenant_id is denormalised for RLS and kept
/// consistent with the membership by trigger.
model MembershipRole {
  membershipId String     @map("membership_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([tenantId])
  @@index([roleId])
  @@map("membership_role")
}

// ---------------------------------------------------------------------------
// MFA (Phase 3B). Phase 3 plan §3.1. Identity jobs only, like credentials.
// ---------------------------------------------------------------------------

/// One TOTP factor per user (WebAuthn later). The secret is AES-256-GCM encrypted.
model MfaFactor {
  userId       String    @id @map("user_id") @db.Uuid
  /// base64(iv | tag | ciphertext) of the 20-byte TOTP secret.
  secretSealed String    @map("secret_sealed") @db.VarChar(200)
  /// Which MFA_ENCRYPTION_KEY sealed it (key rotation).
  keyId        String    @map("key_id") @db.VarChar(32)
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Highest 30-second step accepted so far: a code can never be used twice.
  lastUsedStep BigInt    @default(0) @map("last_used_step")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user         AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("mfa_factor")
}

/// Single-use recovery codes, stored as SHA-256 only.
model RecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("recovery_code")
}

// ---------------------------------------------------------------------------
// Files (Phase 3B). ADR-019, Phase 3 plan §3.3.
// ---------------------------------------------------------------------------

enum FileStatus {
  QUARANTINED
  CLEAN
  REJECTED
}

/// Metadata of an object in the private bucket. Owned by a tenant OR a user.
model FileMetadata {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String?    @map("tenant_id") @db.Uuid
  ownerUserId  String?    @map("owner_user_id") @db.Uuid
  purpose      String     @db.VarChar(50)
  originalName String     @map("original_name") @db.VarChar(255)
  mimeType     String     @map("mime_type") @db.VarChar(100)
  sizeBytes    Int        @map("size_bytes")
  sha256       String     @db.Char(64)
  storageKey   String     @unique @map("storage_key") @db.VarChar(200)
  status       FileStatus @default(QUARANTINED)
  /// Why a file was rejected (scanner verdict code, never file content).
  statusReason String?    @map("status_reason") @db.VarChar(100)
  uploadedBy   String     @map("uploaded_by") @db.Uuid
  scannedAt    DateTime?  @map("scanned_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("file_metadata")
}

// ---------------------------------------------------------------------------
// Organisations (Phase 4). Phase 4 plan §2.
// ---------------------------------------------------------------------------

/// Business details of an organisation tenant (Kenya first, international-ready).
model OrganisationProfile {
  tenantId                    String   @id @map("tenant_id") @db.Uuid
  legalName                   String   @map("legal_name") @db.VarChar(200)
  tradingName                 String?  @map("trading_name") @db.VarChar(200)
  /// Business Registration Service number (Kenya) or the local equivalent.
  registrationNumber          String?  @map("registration_number") @db.VarChar(50)
  registrationNumberAbsentWhy String?  @map("registration_number_absent_why") @db.VarChar(300)
  kraPin                      String?  @map("kra_pin") @db.VarChar(20)
  kraPinAbsentWhy             String?  @map("kra_pin_absent_why") @db.VarChar(300)
  /// ISO 3166-1 alpha-2.
  country                     String   @default("KE") @db.Char(2)
  region                      String?  @db.VarChar(100)
  address                     String?  @db.VarChar(300)
  phone                       String?  @db.VarChar(20)
  contactEmail                String?  @map("contact_email") @db.Citext
  industry                    String?  @db.VarChar(100)
  employeeBand                String?  @map("employee_band") @db.VarChar(20)
  version                     Int      @default(0)
  createdAt                   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("organisation_profile")
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

/// One application per organisation tenant. Decisions only through platform context (trigger).
model OrganisationApplication {
  id              String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String                         @unique @map("tenant_id") @db.Uuid
  status          ApplicationStatus              @default(DRAFT)
  applicantUserId String                         @map("applicant_user_id") @db.Uuid
  submittedAt     DateTime?                      @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?                      @map("decided_at") @db.Timestamptz(6)
  decidedBy       String?                        @map("decided_by") @db.Uuid
  /// Latest reviewer reason (changes requested or rejection). Shown to the applicant.
  decisionReason  String?                        @map("decision_reason") @db.VarChar(1000)
  version         Int                            @default(0)
  createdAt       DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events          OrganisationApplicationEvent[]

  @@index([status, submittedAt])
  @@map("organisation_application")
}

/// Append-only history of an application (trigger-protected).
model OrganisationApplicationEvent {
  id            String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String                  @map("application_id") @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  fromStatus    ApplicationStatus?      @map("from_status")
  toStatus      ApplicationStatus       @map("to_status")
  actorUserId   String?                 @map("actor_user_id") @db.Uuid
  reason        String?                 @db.VarChar(1000)
  occurredAt    DateTime                @default(now()) @map("occurred_at") @db.Timestamptz(6)
  application   OrganisationApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
  @@map("organisation_application_event")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Email-bound, single-use, expiring invitation (review §7). Token minted by the worker; only its SHA-256 is stored.
model Invitation {
  id           String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  email        String           @db.Citext
  roleIds      String[]         @map("role_ids") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  tokenHash    String?          @unique @map("token_hash") @db.Char(64)
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  invitedBy    String           @map("invited_by") @db.Uuid
  acceptedBy   String?          @map("accepted_by") @db.Uuid
  acceptedAt   DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@map("invitation")
}

/// Flat list of departments in an organisation (P4-5). Archived, never deleted.
model Department {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  name        String       @db.VarChar(100)
  archivedAt  DateTime?    @map("archived_at") @db.Timestamptz(6)
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships Membership[]

  @@unique([tenantId, name])
  @@map("department")
}

// ---------------------------------------------------------------------------
// Providers (Phase 5). Phase 5 plan §2.
// ---------------------------------------------------------------------------

enum ProviderKind {
  COMPANY
  INDIVIDUAL
}

enum ProviderStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  SUSPENDED
}

enum ExperienceBand {
  UNDER_1_YEAR
  YEARS_1_3
  YEARS_3_5
  OVER_5_YEARS
}

/// Platform-owned skill taxonomy (P5-3). Services name required skills in Phase 6.
model Skill {
  code      String          @id @db.VarChar(60)
  name      String          @db.VarChar(120)
  category  String          @db.VarChar(60)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  providers ProviderSkill[]
  services  ServiceSkill[]

  @@map("skill")
}

/// Platform-owned geography (P5-6): the 47 counties of Kenya first (ISO 3166-2:KE).
model Region {
  code      String           @id @db.VarChar(10)
  country   String           @db.Char(2)
  name      String           @db.VarChar(100)
  active    Boolean          @default(true)
  providers ProviderRegion[]

  @@index([country])
  @@map("region")
}

/// One supply-side entity: a provider company (tenant) OR an individual (user), never both (P5-1).
model Provider {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind          ProviderKind
  /// Provider company: its tenant.
  tenantId      String?                @unique @map("tenant_id") @db.Uuid
  /// Individual provider: the person.
  ownerUserId   String?                @unique @map("owner_user_id") @db.Uuid
  displayName   String                 @map("display_name") @db.VarChar(200)
  status        ProviderStatus         @default(PENDING_APPROVAL)
  phone         String?                @db.VarChar(20)
  homeRegion    String?                @map("home_region") @db.VarChar(10)
  remoteOk      Boolean                @default(false) @map("remote_ok")
  acceptingWork Boolean                @default(true) @map("accepting_work")
  /// Data-protection retention marker (P5-5): rejected individuals may be erased after this.
  retainUntil   DateTime?              @map("retain_until") @db.Timestamptz(6)
  version       Int                    @default(0)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  skills        ProviderSkill[]
  regions       ProviderRegion[]
  workingHours  ProviderWorkingHours[]
  timeOff       ProviderTimeOff[]
  application   ProviderApplication?

  @@map("provider")
}

model ProviderSkill {
  providerId String         @map("provider_id") @db.Uuid
  skillCode  String         @map("skill_code") @db.VarChar(60)
  experience ExperienceBand @default(YEARS_1_3)
  provider   Provider       @relation(fields: [providerId], references: [id], onDelete: Restrict)
  skill      Skill          @relation(fields: [skillCode], references: [code], onDelete: Restrict)

  @@id([providerId, skillCode])
  @@index([skillCode])
  @@map("provider_skill")
}

model ProviderRegion {
  providerId String   @map("provider_id") @db.Uuid
  regionCode String   @map("region_code") @db.VarChar(10)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  region     Region   @relation(fields: [regionCode], references: [code], onDelete: Restrict)

  @@id([providerId, regionCode])
  @@index([regionCode])
  @@map("provider_region")
}

/// Weekly working hours in Africa/Nairobi. ISO weekday 1 (Mon) to 7 (Sun); minutes since midnight.
model ProviderWorkingHours {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  weekday     Int      @db.SmallInt
  startMinute Int      @map("start_minute") @db.SmallInt
  endMinute   Int      @map("end_minute") @db.SmallInt
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, weekday])
  @@map("provider_working_hours")
}

model ProviderTimeOff {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6)
  reason     String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, startsAt])
  @@map("provider_time_off")
}

/// Same lifecycle as organisation applications (shared transition rules).
model ProviderApplication {
  id              String                     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  providerId      String                     @unique @map("provider_id") @db.Uuid
  status          ApplicationStatus          @default(DRAFT)
  applicantUserId String                     @map("applicant_user_id") @db.Uuid
  submittedAt     DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?                  @map("decided_at") @db.Timestamptz(6)
  decidedBy       String?                    @map("decided_by") @db.Uuid
  decisionReason  String?                    @map("decision_reason") @db.VarChar(1000)
  version         Int                        @default(0)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  provider        Provider                   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  events          ProviderApplicationEvent[]
  verifications   ProviderVerification[]

  @@index([status, submittedAt])
  @@map("provider_application")
}

model ProviderApplicationEvent {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus?  @map("from_status")
  toStatus      ApplicationStatus   @map("to_status")
  actorUserId   String?             @map("actor_user_id") @db.Uuid
  reason        String?             @db.VarChar(1000)
  occurredAt    DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(6)
  application   ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@index([applicationId, occurredAt])
  @@map("provider_application_event")
}

/// Reviewer's structured verdict at approval (Phase 5 plan §2.2). Platform-only.
model ProviderVerification {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId       String              @map("application_id") @db.Uuid
  reviewerUserId      String              @map("reviewer_user_id") @db.Uuid
  identityChecked     Boolean             @map("identity_checked")
  registrationChecked Boolean             @map("registration_checked")
  taxChecked          Boolean             @map("tax_checked")
  skillsChecked       Boolean             @map("skills_checked")
  notes               String?             @db.VarChar(1000)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  application         ProviderApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@map("provider_verification")
}

// ---------------------------------------------------------------------------
// Phase 6: service catalogue (platform-owned, no tenant column; review §4.1).
// Hand-written SQL in the migration adds the CHECK constraints, the search
// vector trigger, the append-only price trigger and row-level security.
// ---------------------------------------------------------------------------

enum CatalogueStatus {
  ACTIVE
  ARCHIVED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ServiceAudience {
  ALL
  ORGANISATIONS
  INDIVIDUALS
}

enum DeliveryMode {
  ON_SITE
  REMOTE
  BOTH
}

enum PriceModel {
  FIXED
  PER_UNIT
  FROM
  QUOTE
}

enum PriceUnit {
  HOUR
  DEVICE
  USER
  VISIT
  POINT
}

/// Two-level tree (top level and one level below). Slug fixed at creation.
model ServiceCategory {
  id        String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parentId  String?           @map("parent_id") @db.Uuid
  slug      String            @unique @db.VarChar(80)
  name      String            @db.VarChar(120)
  summary   String?           @db.VarChar(300)
  icon      String            @default("folder") @db.VarChar(40)
  position  Int               @default(0)
  status    CatalogueStatus   @default(ACTIVE)
  version   Int               @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent    ServiceCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ServiceCategory[] @relation("CategoryTree")
  services  Service[]

  @@index([parentId, position])
  @@map("service_category")
}

model Service {
  id                   String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId           String                   @map("category_id") @db.Uuid
  /// Immutable once the service has been published (trigger).
  slug                 String                   @unique @db.VarChar(100)
  name                 String                   @db.VarChar(150)
  summary              String                   @default("") @db.VarChar(300)
  /// Plain text; paragraphs separated by blank lines. Never rendered as HTML.
  description          String                   @default("")
  inclusions           String[]                 @default([])
  exclusions           String[]                 @default([])
  customerRequirements String[]                 @default([]) @map("customer_requirements")
  typicalDuration      String?                  @map("typical_duration") @db.VarChar(100)
  audience             ServiceAudience          @default(ALL)
  deliveryMode         DeliveryMode             @default(ON_SITE) @map("delivery_mode")
  channelOgs           Boolean                  @default(true) @map("channel_ogs")
  channelIndividual    Boolean                  @default(true) @map("channel_individual")
  channelCompany       Boolean                  @default(true) @map("channel_company")
  status               ServiceStatus            @default(DRAFT)
  publishedAt          DateTime?                @map("published_at") @db.Timestamptz(6)
  retiredAt            DateTime?                @map("retired_at") @db.Timestamptz(6)
  createdBy            String?                  @map("created_by") @db.Uuid
  version              Int                      @default(0)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Maintained by trigger (name unstemmed + stemmed English text); GIN index in SQL.
  searchVector         Unsupported("tsvector")? @map("search_vector")
  category             ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  prices               ServicePrice[]
  skills               ServiceSkill[]

  @@index([categoryId, status])
  @@index([status, name])
  @@index([searchVector], map: "service_search_vector_idx", type: Gin)
  @@map("service")
}

/// Append-only price versions (P6-3). Amounts in integer minor units (cents), excluding VAT (P6-8).
model ServicePrice {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceId     String     @map("service_id") @db.Uuid
  model         PriceModel
  amountMinor   BigInt?    @map("amount_minor")
  currency      String     @default("KES") @db.Char(3)
  unit          PriceUnit?
  minQuantity   Int        @default(1) @map("min_quantity")
  effectiveFrom DateTime   @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdBy     String?    @map("created_by") @db.Uuid
  service       Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, effectiveFrom])
  @@map("service_price")
}

model ServiceSkill {
  serviceId     String         @map("service_id") @db.Uuid
  skillCode     String         @map("skill_code") @db.VarChar(60)
  minExperience ExperienceBand @default(UNDER_1_YEAR) @map("min_experience")
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  skill         Skill          @relation(fields: [skillCode], references: [code], onDelete: Restrict)

  @@id([serviceId, skillCode])
  @@index([skillCode])
  @@map("service_skill")
}
