# OGS API environment (copy to apps/api/.env — never commit .env files)
# Validated at startup by @ogs/contracts (apiEnvSchema).

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000

# Comma-separated list of allowed browser origins.
API_CORS_ORIGINS=http://localhost:5173

# Local development infrastructure (infrastructure/docker/compose.yaml).
# Passwords must match the OGS_*_PASSWORD / REDIS_PASSWORD values in the root .env.
# Placeholder credentials only: replace locally, never reuse in other environments.

# Runtime connection (API + worker). Always the ogs_app role: RLS applies, no bypass.
DATABASE_URL=postgresql://ogs_app:change-me-local-only@localhost:5432/ogs_dev
# Migrations only (read by prisma.config.ts). Never used by the running API.
DATABASE_MIGRATION_URL=postgresql://ogs_owner:change-me-local-only@localhost:5432/ogs_dev
# Dev seed only (BYPASSRLS). Never used by the running API.
DATABASE_MAINT_URL=postgresql://ogs_maint:change-me-local-only@localhost:5432/ogs_dev

REDIS_URL=redis://:change-me-local-only@localhost:6379/0
