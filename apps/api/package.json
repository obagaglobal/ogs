{
  "name": "@ogs/api",
  "version": "0.1.0",
  "private": true,
  "description": "OGS backend API (NestJS)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "dev:worker": "nest start --watch --config nest-cli.worker.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node scripts/db-seed.mjs",
    "db:reset": "node scripts/assert-local-db.mjs && prisma migrate reset --force && node scripts/db-seed.mjs",
    "db:reset:test": "node scripts/db-reset-test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "~12.3.2",
    "@nestjs/config": "~12.0.1",
    "@nestjs/core": "~12.3.2",
    "@nestjs/platform-express": "~12.3.2",
    "@ogs/contracts": "workspace:*",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bullmq": "^6.7.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "~12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "~7.10.1",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
