{
  "name": "@ogs/api",
  "version": "0.1.0",
  "private": true,
  "description": "OGS backend API (NestJS)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format"
  },
  "dependencies": {
    "@nestjs/common": "~12.3.2",
    "@nestjs/config": "~12.0.1",
    "@nestjs/core": "~12.3.2",
    "@nestjs/platform-express": "~12.3.2",
    "@ogs/contracts": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "~12.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "prisma": "~7.10.1",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
