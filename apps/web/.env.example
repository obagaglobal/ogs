# OGS web environment (copy to apps/web/.env — never commit .env files)
#
# IMPORTANT: any variable prefixed with VITE_ is bundled into browser code
# and is public. Never put secrets in VITE_ variables.

# Dev-server only (not exposed to the browser): where /api requests are proxied.
API_PROXY_TARGET=http://127.0.0.1:3000
