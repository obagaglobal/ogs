{
  "name": "ogs",
  "version": "0.1.0",
  "private": true,
  "description": "OGS – ObagaGlobal Services: multi-tenant business services platform (monorepo root)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter @ogs/api run prisma:generate",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter \"./apps/**\" run \"/^dev(:worker)?$/\"",
    "dev:api": "pnpm build:packages && pnpm --filter @ogs/api run dev",
    "dev:web": "pnpm build:packages && pnpm --filter @ogs/web run dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @ogs/api run dev:worker",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "lint": "pnpm build:packages && eslint . --max-warnings=0",
    "lint:fix": "pnpm build:packages && eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "pnpm build:packages && pnpm -r run test",
    "test:integration": "pnpm build:packages && pnpm --filter @ogs/api run test:integration",
    "test:e2e": "pnpm build && pnpm --filter @ogs/web test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "infra:up": "docker compose -f infrastructure/docker/compose.yaml --env-file .env up -d",
    "infra:down": "docker compose -f infrastructure/docker/compose.yaml --env-file .env down",
    "infra:logs": "docker compose -f infrastructure/docker/compose.yaml --env-file .env logs -f",
    "infra:validate": "docker compose -f infrastructure/docker/compose.yaml --env-file .env.example config --quiet",
    "db:roles": "docker compose -f infrastructure/docker/compose.yaml --env-file .env exec -T postgres sh /docker-entrypoint-initdb.d/00-ogs-roles.sh",
    "db:migrate": "pnpm --filter @ogs/api run db:migrate",
    "db:migrate:dev": "pnpm --filter @ogs/api run db:migrate:dev",
    "db:seed": "pnpm --filter @ogs/api run db:seed",
    "db:reset": "pnpm --filter @ogs/api run db:reset",
    "db:reset:test": "pnpm --filter @ogs/api run db:reset:test",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
