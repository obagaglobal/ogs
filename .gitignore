# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-worker/
build/
*.tsbuildinfo
coverage/

# Generated Prisma client
apps/api/src/generated/

# Environment files (never commit secrets)
.env
.env.*
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# Vite
*.local

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/lighthouse-report/
apps/web/.lighthouseci/

# AI-agent skills installed by tools (e.g. the Prisma CLI's "agent skills"
# offer): third-party agent instructions must never enter the repository.
apps/api/.claude/
apps/api/.windsurf/
apps/api/.agents/
apps/api/skills-lock.json

# Phase 6b: only the Linux (CI) screenshot baselines are committed.
apps/web/e2e/__screenshots__/**/*-win32.png
apps/web/e2e/__screenshots__/**/*-darwin.png
